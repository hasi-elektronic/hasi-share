    {
      "id": "http-404",
      "name": "HTTP 404",
      "url": "http://<LAN-IP>:8000/does-not-exist.m3u8",
      "container": "hls",
      "expect": {
        "media3": "error:StreamOffline",
        "avplayer": "error:StreamOffline"
      }
    },
    {
      "id": "dead-host",
      "name": "Unreachable host",
      "url": "http://10.255.255.1:9/live.m3u8",
      "container": "hls",
      "expect": {
        "media3": "error:Network",
        "avplayer": "error:Network"
      },
      "checks": [
        "retry with backoff, then error UI"
      ]
    }
  ]
}