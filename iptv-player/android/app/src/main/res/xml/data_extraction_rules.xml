<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: database (content cache incl. M3U URLs), Keystore-encrypted secrets and DataStore
     (license token, settings) are excluded from cloud backup AND device transfer (SECURITY §1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
