<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV sources added by the user are mostly plain HTTP (ARCHITECTURE V17, SECURITY §3).
     The backend itself is always HTTPS in production. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
