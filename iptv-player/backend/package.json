{
  "name": "iptv-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IPTV player backend: licensing, accounts, sync, TV pairing (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && node --test scripts/keygen.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "keygen": "node scripts/keygen.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "build:dry": "wrangler deploy --dry-run --outdir dist",
    "test:workers": "vitest run",
    "test:scripts": "node --test scripts/keygen.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "4.124.0"
  }
}
