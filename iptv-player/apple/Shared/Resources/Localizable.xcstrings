    "trial_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Free trial: %1$lld day. When it ends, playback is locked until you buy the one-time unlock (%2$@). Sources and settings stay available."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Free trial: %1$lld days. When it ends, playback is locked until you buy the one-time unlock (%2$@). Sources and settings stay available."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ücretsiz deneme: %1$lld gün. Süre bitince tek seferlik kilit açma (%2$@) satın alınana kadar oynatma kilitlenir. Kaynaklar ve ayarlar erişilebilir kalır."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
