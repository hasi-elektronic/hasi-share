<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build 17: reads the Top Shelf snapshot the tvOS app writes into the shared group (TopShelfStore). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
