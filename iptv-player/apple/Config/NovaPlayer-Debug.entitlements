<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only: debuggable builds; required by local StoreKit testing (SKTestSession). -->
	<key>get-task-allow</key>
	<true/>
	<!-- Build 17: same Keychain groups as NovaPlayer.entitlements (own group first, then the Top Shelf group). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID)</string>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
